{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SynaptClip",
  "version": "0.5.1",
  "identifier": "io.aatish.synaptclip",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SynaptClip",
        "width": 680,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "SynaptClip Settings",
        "url": "index.html#settings",
        "width": 540,
        "height": 620,
        "minWidth": 480,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": false,
        "center": true,
        "skipTaskbar": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "",
      "endpoints": [
        "https://raw.githubusercontent.com/aatishbagal/synapt-clip/main/updater.json"
      ],
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "Aatish Bagal",
    "copyright": "Copyright © 2026 Aatish Bagal",
    "category": "Utility",
    "shortDescription": "Clipboard manager with cross-device sync",
    "longDescription": "SynaptClip is a clipboard manager for Linux and Windows. It captures clipboard history, provides fast full-text search, and integrates with Synapt for cross-device clipboard sharing over LAN.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
